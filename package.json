{
  "name": "small-state",
  "version": "0.3.3",
  "description": "A state machine inspired by XState.",
  "author": "qyvvy",
  "license": "MIT",
  "repository": "github:qyvvy/small-state",
  "keywords": ["state machine", "fsm", "state", "xstate"],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "THIRD_PARTY_LICENSES.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "arktype": "^2.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.3.14",
    "tsdown": "^0.23.0",
    "typescript": "~5.8.3"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm,cjs --dts",
    "compile": "bun run build",
    "typecheck": "tsc --noEmit",
    "prepack": "bun typecheck && bun compile"
  },
  "sideEffects": false
}
